# docker compose reads these only when referenced from compose; values below
# mirror the defaults documented in README.md.
WORK_ROOT=/data/jobs
MAX_UPLOAD_BYTES=268435456
MAX_ARCHIVE_BYTES=536870912
MAX_ARCHIVE_FILES=10000
COMMAND_TIMEOUT_SECONDS=300
INLINE_XML_MAX_BYTES=8388608
JOB_TTL_HOURS=24
LOG_MAX_CHARS=100000
PYLABVIEW_COMMAND=readRSRC
